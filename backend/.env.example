DB_USER=fieldshift_user
DB_PASSWORD=fieldshift_password
DB_HOST=db
DB_PORT=5432
DB_NAME=fieldshift_db

DATABASE_URL=postgresql+psycopg2://fieldshift_user:fieldshift_password@db:5432/fieldshift_db

# Module 6 settings
MODULE3_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
DISEASE_CONFIDENCE_THRESHOLD=0.70
DISEASE_MODEL_WEIGHTS_PATH=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20

# Shared challenge foundation is safe-off until each module passes its release gates.
CHALLENGE_CLIMATE_ENABLED=false
CHALLENGE_ADVISORY_ENABLED=false
CHALLENGE_ROTATION_ENABLED=false
CHALLENGE_ADAPTIVE_DECISIONS_ENABLED=false
CHALLENGE_ACTION_CONFIRMATION_ENABLED=false
CHALLENGE_DISEASE_PROBLEM_SYNC_ENABLED=false
CHALLENGE_VOICE_ENABLED=false
OFFLINE_MODE=false
CLIMATE_CACHE_DIR=data/climate/cache

# Module 1 — JWT secret key. Set a long random value in your local environment.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Leaving it blank will cause the app to refuse to start (fail-closed).
SECRET_KEY=
